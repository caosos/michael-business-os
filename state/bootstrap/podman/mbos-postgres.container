# Quadlet unit (target runtime per integration plan: Podman + Quadlet + systemd). UNTESTED here:
# Podman is not installed on the EliteDesk as of 2026-10-07. Pin the image by digest before go-live.
# Install: ~/.config/containers/systemd/ (rootless) then `systemctl --user daemon-reload`.
[Unit]
Description=MBOS state spine PostgreSQL 16 + pgvector (Quadlet)

[Container]
Image=docker.io/pgvector/pgvector:pg16
ContainerName=mbos-postgres
Volume=mbos-pgdata.volume:/var/lib/postgresql/data
Volume=%h/.local/share/mbos/run:/var/run/postgresql:z
PublishPort=127.0.0.1:55432:5432
Secret=mbos-pg-superuser,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8 --locale=C.UTF-8 --auth-host=scram-sha-256
Environment=TZ=UTC
Exec=postgres -c wal_level=replica -c synchronous_commit=on -c password_encryption=scram-sha-256 -c timezone=UTC
HealthCmd=pg_isready -U postgres
HealthInterval=30s
HealthRetries=5
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=default.target
