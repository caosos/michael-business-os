{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MBOS source registry v1",
  "type": "object",
  "required": [
    "version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "display_name",
        "coverage",
        "access_mode",
        "status",
        "policy_ref"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "enum": [
                "national",
                "states",
                "metro",
                "point"
              ]
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "minItems": 1
            },
            "center": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lat",
                "lng"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            },
            "radius_mi": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "subdomain": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "enum": [
                      "metro",
                      "point"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "center",
                  "radius_mi"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "states"
                  }
                }
              },
              "then": {
                "required": [
                  "states"
                ]
              }
            }
          ]
        },
        "access_mode": {
          "enum": [
            "api",
            "alert_email",
            "manual",
            "excluded",
            "site_feed"
          ],
          "description": "site_feed: the publisher's own pages, robots/crawl-delay respected, auction EVENTS only, no lots."
        },
        "status": {
          "enum": [
            "connected",
            "fixture",
            "not_connected",
            "blocked"
          ]
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "terms_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
