{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/trust/credential-claim.schema.json",
  "title": "Credential claim (specific credential, never bare 'verified')",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "subject",
    "credential",
    "status",
    "provenance_ids"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^clm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "credential": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*_verified$",
      "description": "A SPECIFIC credential id from policy/trust/credentials.v1.json; the bare word 'verified' is rejected by the pattern and by the validator."
    },
    "status": {
      "enum": [
        "verified",
        "not_provided",
        "pending",
        "expired",
        "revoked"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "provider",
            "human",
            "regulator_lookup"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "description": "Required for licence credentials: the jurisdiction the licence was checked in."
    },
    "provenance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^prov_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    }
  }
}
