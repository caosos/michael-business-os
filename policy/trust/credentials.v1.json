{
  "vocabulary_schema": "mbos.trust.credentials/1",
  "version": "2026.10.07-e18",
  "description": "E-18 (ADR-0013 §8, START_HERE §11). Credential status is SPECIFIC. The bare word \"verified\" is invalid as a credential, a field name or a badge: it would ambiguously imply every possible credential. A credential id must be `<what>_verified` (identity_verified, electrical_license_verified, ...) and the <what> must be specific. This file is a VOCABULARY only: it asserts no legal requirement (which jobs need which licence is a jurisdiction pack, E-19). Evidence kinds are the proofs a verifier may cite; validity_days are REC priors until Michael confirms.",
  "reserved_bare_words": ["verified", "is_verified", "verified_user", "user_verified", "fully_verified", "all_verified", "trusted"],
  "generic_qualifiers": ["all", "any", "fully", "full", "general", "trusted", "complete", "every", "licensed", "certified"],
  "statuses": ["verified", "not_provided", "pending", "expired", "revoked"],
  "credentials": [
    { "id": "identity_verified", "label": "Identity verified", "kind": "identity", "requires_jurisdiction": false, "validity_days": 365,
      "evidence_kinds": ["payment_provider_kyc_result", "government_id_check_result"],
      "note": "Performed by the payment/identity provider; Deal Sniffer stores the RESULT and its reference, never the ID document." },
    { "id": "payment_verified", "label": "Payment method verified", "kind": "payment", "requires_jurisdiction": false, "validity_days": 365,
      "evidence_kinds": ["payment_provider_method_result"],
      "note": "A valid payment method on file with the provider; says nothing about funds or identity." },
    { "id": "insurance_verified", "label": "Liability insurance verified", "kind": "insurance", "requires_jurisdiction": false, "validity_days": 365,
      "evidence_kinds": ["insurance_certificate_check", "insurer_confirmation"] },
    { "id": "residential_license_verified", "label": "Residential contractor licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] },
    { "id": "general_contractor_license_verified", "label": "General contractor licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] },
    { "id": "electrical_license_verified", "label": "Electrical licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] },
    { "id": "plumbing_license_verified", "label": "Plumbing licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] },
    { "id": "hvac_license_verified", "label": "HVAC/refrigerant licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] },
    { "id": "gas_license_verified", "label": "Gas-line licence verified", "kind": "license", "requires_jurisdiction": true, "validity_days": 365,
      "evidence_kinds": ["regulator_lookup_result", "licence_document_check"] }
  ]
}
