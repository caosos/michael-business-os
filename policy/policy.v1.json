{
  "policy_schema": "mbos.governance.policy/1",
  "policy_id": "wave-one-default-deny",
  "version": "2026.10.07-w1.7",
  "description": "Round Two wave one. Everything tier 0, every externally consequential action needs Michael's YES, every effector DRY-RUN, no delegation, no real-world spend. Anything not listed here is DENIED.",
  "system_mode": "mvp",
  "delegation_enabled": false,
  "clock_skew_seconds": 300,

  "approval": {
    "approvers": ["michael"],
    "allowed_channels": ["web", "cli", "telegram"],
    "allowed_scopes": ["once"],
    "max_approval_ttl_seconds": 86400,
    "step_up_required": {
      "categories": ["money", "purchase", "offer", "external_commitment"],
      "reversibility": ["irreversible"],
      "untrusted_inputs": true
    }
  },

  "execution": {
    "claim_ttl_seconds": 300,
    "note": "E-05: an execution claim still `executing` after this long is reconciled by provider lookup (never re-sent)."
  },

  "action_request": {
    "max_lifetime_seconds": 604800,
    "allowed_initial_status": ["drafted"],
    "on_behalf_of_required": "michael"
  },

  "categories": {
    "message":             { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "comms",      "require_cost_estimate": false, "quiet_hours": false },
    "sms":                 { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "comms",      "require_cost_estimate": false, "quiet_hours": true },
    "phone_call":          { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "comms",      "require_cost_estimate": false, "quiet_hours": true },
    "email":               { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "comms",      "require_cost_estimate": false, "quiet_hours": false },
    "offer":               { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "money",      "require_cost_estimate": true,  "quiet_hours": false },
    "money":               { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "money",      "require_cost_estimate": true,  "quiet_hours": false },
    "purchase":            { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "money",      "require_cost_estimate": true,  "quiet_hours": false },
    "publishing":          { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "publishing", "require_cost_estimate": false, "quiet_hours": false },
    "scheduling":          { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "scheduling", "require_cost_estimate": false, "quiet_hours": false },
    "price_change":        { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "publishing", "require_cost_estimate": false, "quiet_hours": false },
    "external_commitment": { "decision": "require_approval", "tier": 0, "max_tier": 0, "budget_bucket": "money",      "require_cost_estimate": true,  "quiet_hours": false }
  },

  "capabilities": {
    "comms.sms.send":              { "category": "sms",                 "effector": "dryrun" },
    "comms.email.send":            { "category": "email",               "effector": "dryrun" },
    "comms.voice.call":            { "category": "phone_call",          "effector": "dryrun" },
    "comms.message.send":          { "category": "message",             "effector": "dryrun" },
    "offer.submit":                { "category": "offer",               "effector": "dryrun" },
    "offer.email.send":            { "category": "offer",               "effector": "dryrun" },
    "offer.sms.send":              { "category": "offer",               "effector": "dryrun" },
    "offer.message.send":          { "category": "offer",               "effector": "dryrun" },
    "offer.email.counter":         { "category": "offer",               "effector": "dryrun" },
    "offer.sms.counter":           { "category": "offer",               "effector": "dryrun" },
    "offer.message.counter":       { "category": "offer",               "effector": "dryrun" },
    "money.payment.send":          { "category": "money",               "effector": "dryrun" },
    "purchase.create":             { "category": "purchase",            "effector": "dryrun" },
    "publish.listing.create":      { "category": "publishing",          "effector": "dryrun" },
    "publish.content.post":        { "category": "publishing",          "effector": "dryrun" },
    "schedule.appointment.create": { "category": "scheduling",          "effector": "dryrun" },
    "price.change":                { "category": "price_change",        "effector": "dryrun" },
    "commit.external":             { "category": "external_commitment", "effector": "dryrun" }
  },

  "grant_semantics": "agent_grants authorize PROPOSING an ActionRequest only. No agent ever executes: the Action Gateway alone calls effectors, after Michael's YES and the 8 guard checks (ruling R7). The proposer's grant is re-checked at execution (G6).",
  "agent_grants": {
    "agent-01-coordinator":    ["offer.submit", "offer.email.send", "offer.sms.send", "offer.message.send", "offer.email.counter", "offer.sms.counter", "offer.message.counter", "purchase.create", "publish.listing.create", "publish.content.post", "money.payment.send", "price.change", "commit.external", "comms.email.send", "comms.sms.send"],
    "agent-02-opportunity":    [],
    "agent-03-economics":      [],
    "agent-04-state":          [],
    "agent-05-governance":     [],
    "agent-06-communications": ["comms.sms.send", "comms.email.send", "comms.voice.call", "comms.message.send", "schedule.appointment.create", "offer.email.send", "offer.sms.send", "offer.message.send", "offer.email.counter", "offer.sms.counter", "offer.message.counter"],
    "agent-07-marketing":      ["publish.listing.create", "publish.content.post"]
  },

  "quiet_hours": {
    "start": "20:00",
    "end": "08:00",
    "timezone": "America/Chicago",
    "note": "Stricter than TCPA 8am-9pm. Policy timezone is used until Agent 06's consent ledger supplies recipient-local time (UNKNOWN)."
  },

  "budgets": {
    "currency": "USD",
    "live": {
      "global_daily_hard_cap": 0,
      "buckets": {
        "comms":      { "per_action_hard_cap": 0, "daily_hard_cap": 0 },
        "money":      { "per_action_hard_cap": 0, "daily_hard_cap": 0 },
        "publishing": { "per_action_hard_cap": 0, "daily_hard_cap": 0 },
        "scheduling": { "per_action_hard_cap": 0, "daily_hard_cap": 0 }
      }
    },
    "dry_run": {
      "note": "Shadow caps: simulated spend is reserved/committed against these so the budget guard is exercised without spending. Money defaults follow Agent 03 REC ($1,500 per deal) pending MICHAEL_DECISIONS #1.",
      "global_daily_hard_cap": 2000,
      "buckets": {
        "comms":      { "per_action_hard_cap": 1,    "daily_hard_cap": 5 },
        "money":      { "per_action_hard_cap": 1500, "daily_hard_cap": 1500 },
        "publishing": { "per_action_hard_cap": 50,   "daily_hard_cap": 50 },
        "scheduling": { "per_action_hard_cap": 0,    "daily_hard_cap": 0 }
      }
    },
    "velocity": {
      "money_bucket_actions_per_hour": 3
    }
  },

  "recommendation_actions": {
    "note": "E-12 (Deal Sniffer card: CONTACT / OFFER / COUNTER / BUY). CONTACT is plain comms.* (no commitment). OFFER and COUNTER are binding => offer.* (category offer). BUY is purchase.* (category purchase). All tier 0 with step-up. A binding offer can NEVER be created under comms.* or publish.*: comms.* may only map to comms categories, publish.* only to publishing, and a comms.*/publish.* request whose payload carries a binding key is denied. F-22: publish.listing.create / publish.content.post are propose-only grants for the drafting agents (07 and the spine's proposer 01): tier 0, category publishing, default deny otherwise.",
    "binding_namespaces": { "offer.": "offer", "purchase.": "purchase" },
    "comms_namespace": "comms.",
    "publish_namespace": "publish.",
    "comms_categories": ["message", "sms", "phone_call", "email"],
    "binding_payload_keys": ["offer", "offer_amount", "offer_usd", "counter", "counter_offer", "bid_amount", "binding"],
    "cash_at_risk": {
      "max_per_flip_usd": 1500,
      "max_total_active_usd": 3000,
      "basis": "MICHAEL_DECISIONS #1 is UNDECIDED: conservative defaults. Per-flip follows Agent 03 REC ($1,500 per deal); total is 2x. Applies to dry-run (shadow) reservations of offer/purchase requests; live spend stays pinned at 0."
    }
  },

  "egress": {
    "default": "deny",
    "note": "Per-agent outbound host allow-lists for the default-deny egress proxy. Wave one: every list is empty (fixture/dry-run only). Opening a host is a policy.schema.json change (Agent 05 + 01 review), e.g. Agent 02 read-only discovery sources.",
    "allow": {},
    "catalog": [
      { "id": "adapter:ebay_browse",    "owner": "agent-02-opportunity", "kind": "source_adapter", "hosts": ["api.ebay.com"],
        "scheme": "https", "port": 443, "methods": ["GET"], "enabled": false,
        "purpose": "eBay Browse API, read-only listings/comps (02 runbook; needs Michael's keyset)", "basis": "INFERENCE: host per eBay developer docs; 02 to confirm" },
      { "id": "adapter:gsa_auctions",   "owner": "agent-02-opportunity", "kind": "source_adapter", "hosts": ["api.gsa.gov"],
        "scheme": "https", "port": 443, "methods": ["GET"], "enabled": false,
        "purpose": "GSA Auctions API, read-only (B-03)", "basis": "INFERENCE: api.gsa.gov hosts GSA public APIs; 02 to confirm path/host" },
      { "id": "adapter:trash_nothing",  "owner": "agent-02-opportunity", "kind": "source_adapter", "hosts": ["trashnothing.com"],
        "scheme": "https", "port": 443, "methods": ["GET"], "enabled": false,
        "purpose": "Trash Nothing API, read-only (B-03)", "basis": "INFERENCE: API served from trashnothing.com; 02 to confirm" }
    ]
  },

  "llm_spend": {
    "enforced_by": "LiteLLM virtual keys (ADR-0005 §6) — NOT by this gateway",
    "default_agent_daily_usd": 2,
    "per_agent_daily_usd": {},
    "max_tokens_per_call": 4096
  }
}
