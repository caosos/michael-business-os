{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/contracts/item.schema.json",
  "title": "Item v1 — canonical Opportunity envelope (flips + services)",
  "description": "Owner: Agent 01 (ADR-0004). One envelope for BOTH revenue lanes (ADR-0007): value-add FLIPS and paid SERVICES, discriminated by `type`. Normalized listing fields come from Agent 02 (ADR-02-0201); the `economics` blocks and `scores` are Agent 03's schemas referenced verbatim (vendor/agent-03, scoring_config_version-pinned). Action requests, approvals, receipts, outcomes and provenance are separate append-only records referenced by id — the Item never embeds or mutates them. Evidence tags use FACT|INFERENCE|RECOMMENDATION|UNKNOWN.",
  "type": "object",
  "required": ["item_id", "schema_version", "type", "category", "state", "created_at", "sources", "dedup_key", "normalized"],
  "additionalProperties": false,
  "properties": {
    "item_id": { "$ref": "#/$defs/ulid_itm" },
    "schema_version": { "const": "1.0.0" },
    "type": { "enum": ["flip", "service"], "description": "Revenue lane. Neither lane is privileged; vehicles are one flip category, home services one service lane." },
    "category": {
      "description": "Canonical category per Michael's 2026-10-06 scope (ADR-0007). Use `subcategory` for detail; `other_*` is the escape hatch, never a reason to add a third type.",
      "enum": [
        "trailer", "mower", "generator", "welder", "compressor", "tool",
        "commercial_equipment", "mechanical_equipment", "project_vehicle", "other_asset",
        "mobile_repair", "equipment_repair", "drywall_repair", "assembly", "handyman",
        "smart_home_install", "technical_service", "mechanical_service", "other_service"
      ]
    },
    "subcategory": { "type": "string", "description": "Free text, e.g. 'utility trailer 6x12', 'zero-turn', 'TV wall mount'." },
    "opportunity_kind": {
      "enum": ["buy_item", "auction_lot", "free_item", "service_lead", "gov_contract"],
      "description": "Agent 02's acquisition-channel discriminator (formerly `opportunity_type`)."
    },
    "state": {
      "description": "Business-flow state (ADR-0004 §state machine). Per-action execution status lives on ActionRequest, not here.",
      "enum": [
        "DISCOVERED", "NORMALIZED", "RESEARCHING", "SCORED", "RECOMMENDED",
        "AWAITING_APPROVAL", "HELD", "APPROVED", "REJECTED",
        "ACTING", "ACTED", "OUTCOME_RECORDED", "LEARNED",
        "ARCHIVED", "FAILED"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per source sighting; cross-source merges append here (fixes Agent 02's scalar `source`).",
      "items": {
        "type": "object",
        "required": ["source", "url", "ingestion_method", "first_seen_at", "provenance_id"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "examples": ["ebay", "craigslist", "govdeals", "hibid", "estatesales_net", "trashnothing", "samgov", "referral", "website_lead", "thumbtack"] },
          "source_listing_id": { "type": "string" },
          "url": { "type": "string" },
          "ingestion_method": { "enum": ["api", "json", "email", "rss", "browser", "manual", "inbound_call", "inbound_form"] },
          "tos_risk": { "enum": ["low", "med", "high"] },
          "first_seen_at": { "type": "string", "format": "date-time" },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "raw_ref": { "$ref": "#/$defs/sha256", "description": "Content-addressed artifact holding the immutable as-discovered payload (Agent 04 artifact store)." },
          "provenance_id": { "$ref": "#/$defs/ulid_prov" }
        }
      }
    },
    "dedup_key": { "type": "string", "description": "Agent 02 §7 blocking key hash." },
    "content_hash": { "type": "string" },
    "normalized": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "enum": ["new", "used", "parts", "unknown", "n/a"] },
        "price": {
          "type": "object",
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "default": "USD" },
            "type": { "enum": ["fixed", "auction_current", "starting_bid", "free", "lead_cost", "customer_budget", "quote_requested"] },
            "buyer_premium_pct": { "type": "number", "minimum": 0 }
          }
        },
        "ends_at": { "type": "string", "format": "date-time" },
        "bid_count": { "type": "integer", "minimum": 0 },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "zip": { "type": "string" },
            "road_miles_one_way": { "type": "number", "minimum": 0, "description": "Canonical distance (Agent 03). Agent 02 `distance_miles` maps here." },
            "geo_tier": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "counterparty": {
          "type": "object",
          "description": "Seller (flip) or customer (service). Contact values are stored, never auto-actioned without an approved ActionRequest.",
          "properties": {
            "party_id": { "type": "string" },
            "role": { "enum": ["seller", "buyer", "customer", "agency", "other"] },
            "name": { "type": "string" },
            "is_dealer": { "type": "boolean" },
            "contact_method": { "enum": ["relay_email", "phone", "in_app", "platform", "gov_poc", "email", "none"] }
          }
        },
        "images": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "listing_status": { "enum": ["active", "ended", "sold", "gone", "open", "closed"] },
        "flags": {
          "type": "array",
          "items": { "enum": ["underpriced", "zero_bid", "free", "ending_soon", "long_distance", "needs_review", "price_changed", "injection_suspected"] }
        }
      }
    },
    "economics": {
      "description": "Agent 03 economics inputs. Shape depends on `type` (enforced below).",
      "type": "object"
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "basis", "provenance_id"],
        "additionalProperties": false,
        "properties": {
          "finding": { "type": "string" },
          "field": { "type": "string", "description": "Economics field this finding supports, if any." },
          "basis": { "$ref": "#/$defs/evidence_tag" },
          "source_uri": { "type": "string" },
          "fetched_at": { "type": "string", "format": "date-time" },
          "provenance_id": { "$ref": "#/$defs/ulid_prov" }
        }
      }
    },
    "scores": {
      "type": "object",
      "required": ["scorecard_id", "inputs_hash", "scorecard"],
      "additionalProperties": false,
      "properties": {
        "scorecard_id": { "type": "string", "pattern": "^scr_[0-9A-HJKMNP-TV-Z]{26}$", "description": "Stable id Agent 05 cites as `score_ref`." },
        "inputs_hash": { "$ref": "#/$defs/sha256", "description": "sha256 of canonical(economics + research ids + scoring_config_version) — makes AT-1 replay checkable." },
        "scorecard": { "$ref": "https://michael-business-os/schemas/scorecard.schema.json" }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["recommendation_id", "verdict", "rationale", "provenance_id"],
      "additionalProperties": false,
      "properties": {
        "recommendation_id": { "type": "string", "pattern": "^rec_[0-9A-HJKMNP-TV-Z]{26}$" },
        "verdict": { "enum": ["YES", "MAYBE", "PASS"], "description": "Machine verdict (Agent 03). NOT Michael's decision — that is Approval.decision (YES|NO|MODIFY|HOLD)." },
        "proposed_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "summary", "reversibility"],
            "properties": {
              "capability": { "type": "string", "examples": ["comms.sms.send", "money.payment.send", "schedule.appointment.create", "publish.listing.create"] },
              "summary": { "type": "string" },
              "reversibility": { "enum": ["reversible", "partially_reversible", "irreversible"] },
              "estimated_cost": { "$ref": "#/$defs/money" }
            }
          }
        },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cheapest_decisive_evidence": { "type": "string" },
        "alert": { "type": "boolean" },
        "provenance_id": { "$ref": "#/$defs/ulid_prov" }
      }
    },
    "action_request_ids": { "type": "array", "items": { "type": "string", "pattern": "^areq_[0-9A-HJKMNP-TV-Z]{26}$" } },
    "approval_ids": { "type": "array", "items": { "type": "string", "pattern": "^appr_[0-9A-HJKMNP-TV-Z]{26}$" } },
    "receipt_ids": { "type": "array", "items": { "type": "string", "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$" } },
    "outcome_ids": { "type": "array", "items": { "type": "string", "pattern": "^outc_[0-9A-HJKMNP-TV-Z]{26}$" } },
    "provenance_ids": { "type": "array", "items": { "$ref": "#/$defs/ulid_prov" } }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "flip" } } },
      "then": {
        "properties": {
          "category": { "enum": ["trailer", "mower", "generator", "welder", "compressor", "tool", "commercial_equipment", "mechanical_equipment", "project_vehicle", "other_asset"] },
          "economics": { "$ref": "#/$defs/flip_economics" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "service" } } },
      "then": {
        "properties": {
          "category": { "enum": ["mobile_repair", "equipment_repair", "drywall_repair", "assembly", "handyman", "smart_home_install", "technical_service", "mechanical_service", "other_service"] },
          "economics": { "$ref": "#/$defs/service_economics" }
        }
      }
    }
  ],
  "$defs": {
    "ulid_itm": { "type": "string", "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$" },
    "ulid_prov": { "type": "string", "pattern": "^prov_[0-9A-HJKMNP-TV-Z]{26}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_tag": { "enum": ["FACT", "INFERENCE", "RECOMMENDATION", "UNKNOWN"] },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": { "amount": { "type": "number" }, "currency": { "type": "string" } }
    },
    "flip_economics": {
      "type": "object",
      "required": ["acquisition", "rehab", "logistics", "holding", "resale", "downside", "estimates_meta"],
      "additionalProperties": false,
      "properties": {
        "acquisition": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/acquisition" },
        "rehab": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/rehab" },
        "logistics": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/logistics" },
        "holding": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/holding" },
        "resale": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/resale" },
        "downside": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/downside" },
        "estimates_meta": { "$ref": "https://michael-business-os/schemas/opportunity.schema.json#/properties/estimates_meta" }
      }
    },
    "service_economics": {
      "type": "object",
      "required": ["logistics", "job", "estimates_meta"],
      "additionalProperties": false,
      "properties": {
        "logistics": { "$ref": "https://michael-business-os/schemas/service-job.schema.json#/properties/logistics" },
        "job": { "$ref": "https://michael-business-os/schemas/service-job.schema.json#/properties/job" },
        "estimates_meta": { "$ref": "https://michael-business-os/schemas/service-job.schema.json#/properties/estimates_meta" }
      }
    }
  }
}
