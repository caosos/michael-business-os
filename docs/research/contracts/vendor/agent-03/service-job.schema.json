{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/schemas/service-job.schema.json",
  "title": "Service Job Opportunity",
  "description": "Canonical economics record for a service job (labor/skill sold on a customer's property or asset). Reuses location/logistics/estimates_meta/scorecard from the flip schema; drops acquisition/resale/downside; adds the job block. Profit/hour is the governing metric.",
  "type": "object",
  "required": ["opportunity_id", "type", "category", "location", "logistics", "job", "estimates_meta"],
  "properties": {
    "opportunity_id": { "type": "string", "format": "uuid" },
    "type": { "const": "service" },
    "category": { "type": "string", "examples": ["drywall", "smart_home", "welding", "repair", "maintenance", "fabrication", "construction"] },
    "title": { "type": "string" },
    "source": {
      "type": "object",
      "properties": {
        "platform": { "type": "string", "examples": ["referral", "repeat_customer", "facebook", "website_lead", "cold"] },
        "lead_url": { "type": "string" },
        "lead_received_at": { "type": "string", "format": "date-time" },
        "customer_ref": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["road_miles_one_way"],
      "properties": {
        "home_base": { "type": "string", "default": "Conway, AR" },
        "site_lat_lng": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "road_miles_one_way": { "type": "number", "minimum": 0 },
        "estimated_drive_minutes_one_way": { "type": "number", "minimum": 0 }
      }
    },
    "logistics": {
      "type": "object",
      "required": ["trips"],
      "properties": {
        "trips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["purpose", "round_trip_miles"],
            "properties": {
              "purpose": { "type": "string", "examples": ["estimate_visit", "work_day", "material_run", "final_walkthrough"] },
              "round_trip_miles": { "type": "number", "minimum": 0 }
            }
          }
        },
        "fuel_price_per_gal": { "type": "number", "minimum": 0 },
        "vehicle_mpg": { "type": "number", "exclusiveMinimum": 0 },
        "wear_per_mile": { "type": "number", "minimum": 0 },
        "avg_speed_mph": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "job": {
      "type": "object",
      "required": ["quoted_revenue", "labor_hours", "required_skills", "win_prob"],
      "properties": {
        "quoted_revenue": { "type": "number", "minimum": 0, "description": "Total customer pays (labor + passed-through materials)." },
        "labor_revenue": { "type": "number", "minimum": 0, "description": "Revenue attributable to labor = quoted_revenue - materials passed through." },
        "materials_cost": { "type": "number", "minimum": 0, "description": "M, fronted by Michael; may be passed through or marked up." },
        "material_markup_rate": { "type": "number", "minimum": 0, "description": "0 = pass-through at cost." },
        "labor_hours": { "type": "number", "minimum": 0, "description": "H_labor" },
        "admin_hours": { "type": "number", "minimum": 0, "description": "H_admin: quoting, scheduling, invoicing." },
        "required_skills": { "type": "array", "items": { "type": "string" } },
        "win_prob": { "type": "number", "minimum": 0, "maximum": 1, "description": "p_win: 1.0 if awarded; <1 for competitive quote." },
        "completion_prob": { "type": "number", "minimum": 0, "maximum": 1, "description": "P(finished clean, no rework/warranty hit)." },
        "payment_terms_days": { "type": "number", "minimum": 0, "description": "Deposit to final collection; drives time-to-cash." },
        "deposit_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "Reduces cash tied up." },
        "lead_quality": { "type": "number", "minimum": 0, "maximum": 1, "description": "Replaces scarcity: referral/repeat/urgency." }
      }
    },
    "estimates_meta": {
      "type": "object",
      "required": ["scoring_config_version"],
      "properties": {
        "scoring_config_version": { "type": "string" },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "basis"],
            "properties": {
              "field": { "type": "string" },
              "value": {},
              "basis": { "enum": ["FACT", "INFER", "REC", "UNK"] },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "scorecard": { "$ref": "scorecard.schema.json" }
  }
}
