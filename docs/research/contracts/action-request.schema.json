{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/contracts/action-request.schema.json",
  "title": "ActionRequest v1 — one proposed side-effect",
  "description": "Adopted from Agent 05 §4.1/§4.3 (ADR-05-001) with Item linkage added by Agent 01. Every external side-effect is an ActionRequest; the payload is hash-frozen at proposal and re-verified by the execution guard. MODIFY never mutates — it spawns a new request with `derived_from`. Status changes are recorded as Receipts, so this row is current-state only.",
  "type": "object",
  "required": [
    "action_request_id",
    "item_id",
    "created_at",
    "proposed_by",
    "capability",
    "category",
    "payload",
    "payload_hash",
    "idempotency_key",
    "reversibility",
    "tier",
    "status",
    "expires_at",
    "provenance_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "action_request_id": {
      "type": "string",
      "pattern": "^areq_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "recommendation_id": {
      "type": "string",
      "pattern": "^rec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "derived_from": {
      "type": "string",
      "pattern": "^areq_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Set when created by a MODIFY decision."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposed_by": {
      "type": "string",
      "description": "agent_id"
    },
    "on_behalf_of": {
      "const": "michael"
    },
    "capability": {
      "type": "string",
      "description": "Dotted capability, e.g. comms.sms.send, money.payment.send, publish.listing.create, schedule.appointment.create, price.change, commit.external."
    },
    "category": {
      "description": "Agent 05's 11 gated categories.",
      "enum": [
        "message",
        "offer",
        "money",
        "purchase",
        "publishing",
        "scheduling",
        "price_change",
        "phone_call",
        "sms",
        "email",
        "external_commitment"
      ]
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string"
    },
    "estimated_cost": {
      "$ref": "#/$defs/money"
    },
    "max_cost": {
      "$ref": "#/$defs/money"
    },
    "reversibility": {
      "enum": [
        "reversible",
        "partially_reversible",
        "irreversible"
      ]
    },
    "untrusted_inputs_present": {
      "type": "boolean",
      "description": "Taint flag: any input from listings/inbound messages. True forces tier 0."
    },
    "tier": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "description": "05: 0 gated (default), 1 notify+undo (reversible only), 2 bounded standing rule, 3 batch/plan approval."
    },
    "policy_decision_ref": {
      "type": "string"
    },
    "score_ref": {
      "type": "string",
      "pattern": "^scr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "enum": [
        "drafted",
        "classified",
        "pending_approval",
        "held",
        "approved",
        "auto_approved",
        "rejected",
        "expired",
        "executing",
        "executed",
        "failed",
        "outcome_recorded",
        "cancelled_by_freeze"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^prov_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "target": {
      "type": "object",
      "description": "Who/what the action touches (party_id, listing ref, channel address ref). Raw contact values stay in the consent ledger, referenced not copied.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reversibility": {
            "const": "irreversible"
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "untrusted_inputs_present": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "enum": [
              "money",
              "purchase",
              "external_commitment"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tier": {
            "const": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      }
    }
  }
}
