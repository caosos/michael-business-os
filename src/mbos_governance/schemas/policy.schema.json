{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/governance/policy.schema.json",
  "title": "Governance policy data — wave one",
  "description": "Validates policy/*.json before the PDP will use it. A policy file that fails this schema is treated as UNREADABLE and the gateway denies everything. The `const` values below are the WAVE-ONE invariants (tier 0 only, no delegation, no live mode, zero live spend). Loosening them is a deliberate schema change reviewed by Agent 05 + Agent 01 — not a data edit.",
  "type": "object",
  "required": [
    "policy_schema",
    "policy_id",
    "version",
    "system_mode",
    "delegation_enabled",
    "clock_skew_seconds",
    "approval",
    "action_request",
    "categories",
    "capabilities",
    "agent_grants",
    "quiet_hours",
    "budgets",
    "egress",
    "llm_spend",
    "execution",
    "recommendation_actions"
  ],
  "properties": {
    "policy_schema": {
      "const": "mbos.governance.policy/1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "system_mode": {
      "enum": [
        "round_one",
        "mvp"
      ]
    },
    "delegation_enabled": {
      "const": false
    },
    "clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 900
    },
    "approval": {
      "type": "object",
      "required": [
        "approvers",
        "allowed_channels",
        "allowed_scopes",
        "max_approval_ttl_seconds",
        "step_up_required"
      ],
      "properties": {
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowed_channels": {
          "type": "array",
          "items": {
            "enum": [
              "telegram",
              "web",
              "sms_reply",
              "email_reply",
              "cli"
            ]
          }
        },
        "allowed_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "once"
          }
        },
        "max_approval_ttl_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "step_up_required": {
          "type": "object",
          "required": [
            "categories",
            "reversibility",
            "untrusted_inputs"
          ],
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reversibility": {
              "type": "array",
              "items": {
                "enum": [
                  "reversible",
                  "partially_reversible",
                  "irreversible"
                ]
              }
            },
            "untrusted_inputs": {
              "const": true,
              "description": "E-04: tainted requests (untrusted inputs / injection tripwire) always need step-up. Wave one pins it on."
            }
          }
        }
      }
    },
    "action_request": {
      "type": "object",
      "required": [
        "max_lifetime_seconds",
        "allowed_initial_status",
        "on_behalf_of_required"
      ],
      "properties": {
        "max_lifetime_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "allowed_initial_status": {
          "type": "array",
          "items": {
            "const": "drafted"
          }
        },
        "on_behalf_of_required": {
          "const": "michael"
        }
      }
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "message",
          "offer",
          "money",
          "purchase",
          "publishing",
          "scheduling",
          "price_change",
          "phone_call",
          "sms",
          "email",
          "external_commitment"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "decision",
          "tier",
          "max_tier",
          "budget_bucket",
          "require_cost_estimate",
          "quiet_hours"
        ],
        "properties": {
          "decision": {
            "enum": [
              "require_approval",
              "deny"
            ]
          },
          "tier": {
            "const": 0
          },
          "max_tier": {
            "const": 0
          },
          "budget_bucket": {
            "type": "string"
          },
          "require_cost_estimate": {
            "type": "boolean"
          },
          "quiet_hours": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "category",
          "effector"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "effector": {
            "const": "dryrun"
          }
        }
      }
    },
    "agent_grants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z_]+)+$"
        }
      }
    },
    "quiet_hours": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "currency",
        "live",
        "dry_run",
        "velocity"
      ],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "live": {
          "type": "object",
          "required": [
            "global_daily_hard_cap",
            "buckets"
          ],
          "properties": {
            "global_daily_hard_cap": {
              "const": 0
            },
            "buckets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "per_action_hard_cap",
                  "daily_hard_cap"
                ],
                "properties": {
                  "per_action_hard_cap": {
                    "const": 0
                  },
                  "daily_hard_cap": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        "dry_run": {
          "type": "object",
          "required": [
            "global_daily_hard_cap",
            "buckets"
          ],
          "properties": {
            "global_daily_hard_cap": {
              "type": "number",
              "minimum": 0
            },
            "buckets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "per_action_hard_cap",
                  "daily_hard_cap"
                ],
                "properties": {
                  "per_action_hard_cap": {
                    "type": "number",
                    "minimum": 0
                  },
                  "daily_hard_cap": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "velocity": {
          "type": "object",
          "required": [
            "money_bucket_actions_per_hour"
          ],
          "properties": {
            "money_bucket_actions_per_hour": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "llm_spend": {
      "type": "object",
      "required": [
        "default_agent_daily_usd",
        "per_agent_daily_usd",
        "max_tokens_per_call"
      ],
      "properties": {
        "enforced_by": {
          "type": "string"
        },
        "default_agent_daily_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "per_agent_daily_usd": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          }
        },
        "max_tokens_per_call": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        }
      }
    },
    "egress": {
      "type": "object",
      "required": [
        "default",
        "allow",
        "catalog"
      ],
      "properties": {
        "default": {
          "const": "deny"
        },
        "allow": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "string"
            }
          },
          "description": "Wave one: no agent may reach any host (maxItems 0)."
        },
        "catalog": {
          "type": "array",
          "description": "E-07: per adapter/effector egress entries. Wave one: every entry disabled (enabled const false), so the effective allow-list is empty; enabling one is a reviewed schema+data change.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "owner",
              "kind",
              "hosts",
              "scheme",
              "port",
              "methods",
              "enabled",
              "purpose",
              "basis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(adapter|effector):[a-z0-9_.-]+$"
              },
              "owner": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_adapter",
                  "effector"
                ]
              },
              "hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "scheme": {
                "const": "https"
              },
              "port": {
                "const": 443
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                }
              },
              "enabled": {
                "const": false
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "claim_ttl_seconds"
      ],
      "properties": {
        "claim_ttl_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      }
    },
    "recommendation_actions": {
      "type": "object",
      "required": [
        "binding_namespaces",
        "comms_namespace",
        "comms_categories",
        "binding_payload_keys",
        "cash_at_risk"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "binding_namespaces": {
          "const": {
            "offer.": "offer",
            "purchase.": "purchase"
          }
        },
        "comms_namespace": {
          "const": "comms."
        },
        "comms_categories": {
          "const": [
            "message",
            "sms",
            "phone_call",
            "email"
          ]
        },
        "binding_payload_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cash_at_risk": {
          "type": "object",
          "required": [
            "max_per_flip_usd",
            "max_total_active_usd",
            "basis"
          ],
          "properties": {
            "max_per_flip_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "max_total_active_usd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
