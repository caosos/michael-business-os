{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/contracts/outcome.schema.json",
  "title": "Outcome v1 — what actually happened (feeds LEARN)",
  "description": "Owner: Agent 01 contract; storage Agent 04 (`outcomes`); LEARN consumer Agent 03 §16; attribution from Agent 07 §13. Records predicted-vs-actual per economics field so Agent 03 can compute Brier/MAPE and propose a scoring_config version bump. Never edits past scores.",
  "type": "object",
  "required": ["outcome_id", "item_id", "observed_at", "kind", "provenance_ids"],
  "additionalProperties": false,
  "properties": {
    "outcome_id": { "type": "string", "pattern": "^outc_[0-9A-HJKMNP-TV-Z]{26}$" },
    "item_id": { "type": "string", "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$" },
    "action_request_id": { "type": "string", "pattern": "^areq_[0-9A-HJKMNP-TV-Z]{26}$" },
    "scorecard_id": { "type": "string", "pattern": "^scr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "kind": {
      "enum": [
        "flip_acquired", "flip_sold", "flip_unsold_salvaged", "flip_repair_failed", "flip_passed_missed",
        "service_won", "service_lost", "service_completed", "service_rework", "service_paid",
        "wasted_trip", "message_replied", "message_no_reply", "lead_attributed"
      ]
    },
    "predicted_vs_actual": {
      "type": "array",
      "description": "Agent 03 §16 LEARN signals: sell price, H_labor, p_repair, p_sale/win_prob, DOM, costs, wasted trip.",
      "items": {
        "type": "object",
        "required": ["field", "actual"],
        "properties": {
          "field": { "type": "string", "examples": ["resale.target_sell_price", "rehab.labor_hours", "rehab.repair_success_prob", "resale.sale_prob", "job.win_prob", "resale.expected_dom_days"] },
          "predicted": {},
          "actual": {}
        }
      }
    },
    "realized": {
      "type": "object",
      "properties": {
        "revenue": { "type": "number" },
        "total_cost": { "type": "number" },
        "net_profit": { "type": "number" },
        "hours": { "type": "number" },
        "days_to_cash": { "type": "number" }
      }
    },
    "attribution": {
      "type": "object",
      "description": "Agent 07 §13 attribution object.",
      "properties": {
        "first_touch_source": { "type": "string" },
        "first_touch_detail": { "type": "string" },
        "self_reported_source": { "type": "string" },
        "channel": { "type": "string" },
        "utm": { "type": "object" }
      }
    },
    "notes": { "type": "string" },
    "provenance_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^prov_[0-9A-HJKMNP-TV-Z]{26}$" } }
  }
}
