{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michael-business-os/contracts/receipt.schema.json",
  "title": "Receipt v1 — merged ledger event (01 + 04 + 05 + 06 + 07)",
  "description": "Owner: Agent 01 contract (ADR-0004); storage owned by Agent 04 (insert-only, hash-chained, same-transaction as the state change); event vocabulary owned by Agent 05. One row per lifecycle EVENT (05 model) — an executed action therefore has several receipts (PROPOSED → POLICY_DECIDED → APPROVAL_DECIDED → EXECUTING → EXECUTED). Channel-specific detail (06 comms, 07 marketing policy checks) goes in `details`, typed by `details.kind`. NOTE: an action-receipt is NOT a financial receipt document; those are artifacts referenced via `artifact_hashes` (Agent 04 §3).",
  "type": "object",
  "required": ["receipt_id", "seq", "ts", "schema_version", "type", "actor", "intent", "provenance_ids", "idempotency_key", "prev_hash", "row_hash"],
  "additionalProperties": false,
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^rcpt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "seq": { "type": "integer", "minimum": 1, "description": "Monotonic bigint identity; orders the hash chain (Agent 04)." },
    "ts": { "type": "string", "format": "date-time" },
    "schema_version": { "const": "1.0.0" },
    "type": {
      "description": "Agent 05 §11 event vocabulary, plus Item-flow events for non-action transitions.",
      "enum": [
        "ITEM_STATE_CHANGED", "SCORE_RECORDED", "RECOMMENDATION_RECORDED",
        "ACTION_PROPOSED", "POLICY_DECIDED", "APPROVAL_REQUESTED", "APPROVAL_DECIDED",
        "BUDGET_RESERVED", "BUDGET_COMMITTED", "BUDGET_RELEASED",
        "ACTION_EXECUTING", "ACTION_EXECUTED", "ACTION_FAILED",
        "OUTCOME_RECORDED", "LESSON_RECORDED", "CONFIG_VERSION_BUMPED",
        "KILL_SWITCH_CHANGED", "GRANT_CREATED", "GRANT_REVOKED", "INJECTION_SUSPECTED"
      ]
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["agent", "human", "system", "external"] },
        "id": { "type": "string", "description": "agent_id (e.g. 'agent-02-discovery') or human id ('michael')." }
      }
    },
    "intent": { "type": "string", "minLength": 1, "description": "Why, in one line (Agent 04: required)." },
    "item_id": { "type": "string", "pattern": "^itm_[0-9A-HJKMNP-TV-Z]{26}$" },
    "action_request_id": { "type": "string", "pattern": "^areq_[0-9A-HJKMNP-TV-Z]{26}$" },
    "approval_id": { "type": "string", "pattern": "^appr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "capability": { "type": "string" },
    "entity_type": { "type": "string" },
    "entity_id": { "type": "string" },
    "effect": { "enum": ["none", "create", "update", "logical_delete", "send", "pay", "publish", "schedule", "commit"] },
    "tool_name": { "type": "string", "description": "MCP server/tool invoked, with version." },
    "payload_hash": { "$ref": "#/$defs/sha256", "description": "Hash of the frozen action payload (05: re-checked at execution)." },
    "inputs_hash": { "$ref": "#/$defs/sha256", "description": "Hash of all inputs the actor consumed (01)." },
    "idempotency_key": { "type": "string", "description": "UNIQUE. Re-executing with the same key is a no-op (05 execution guard check #4)." },
    "before_state": { "type": ["object", "null"] },
    "after_state": { "type": ["object", "null"] },
    "policy_decision_ref": { "type": "string" },
    "budget_effect": {
      "type": "object",
      "description": "Real-world spend (Agent 05 budget ledger).",
      "required": ["category", "amount", "currency"],
      "properties": {
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" }
      }
    },
    "llm_cost": {
      "type": "object",
      "description": "Model spend attributable to this event (LiteLLM virtual-key accounting; Langfuse trace).",
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "trace_id": { "type": "string" }
      }
    },
    "effector_response": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "provider_msg_id": { "type": "string" },
        "status": { "type": "string" },
        "dry_run": { "type": "boolean", "description": "MUST be true for every effector receipt in Round One / MVP." }
      }
    },
    "provenance_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^prov_[0-9A-HJKMNP-TV-Z]{26}$" }, "description": "No receipt without provenance: at least one." },
    "artifact_hashes": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
    "outcome_id": { "type": "string", "pattern": "^outc_[0-9A-HJKMNP-TV-Z]{26}$" },
    "details": {
      "type": "object",
      "required": ["kind"],
      "description": "Typed per-channel extension. kind=comms → Agent 06 §13 block; kind=marketing → Agent 07 §15 policy_checks/draft refs.",
      "properties": {
        "kind": { "enum": ["comms", "marketing", "money", "generic"] }
      }
    },
    "prev_hash": { "type": ["string", "null"], "description": "row_hash of seq-1 (null only for genesis)." },
    "row_hash": { "$ref": "#/$defs/sha256", "description": "sha256(canonical(row without row_hash) || prev_hash), computed in a DB trigger." }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["ACTION_PROPOSED", "POLICY_DECIDED", "APPROVAL_REQUESTED", "APPROVAL_DECIDED", "BUDGET_RESERVED", "BUDGET_COMMITTED", "BUDGET_RELEASED", "ACTION_EXECUTING", "ACTION_EXECUTED", "ACTION_FAILED"] } } },
      "then": { "required": ["action_request_id", "capability", "payload_hash"] }
    },
    {
      "if": { "properties": { "type": { "const": "APPROVAL_DECIDED" } } },
      "then": { "required": ["approval_id"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["ACTION_EXECUTED", "ACTION_FAILED"] } } },
      "then": { "required": ["approval_id", "effector_response", "effect"] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
